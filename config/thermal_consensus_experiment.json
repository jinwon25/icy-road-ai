{
  "experiment_id": "20261013_thermal_consensus_v1",
  "scope": "이미 반복 사용한 첫 겨울 개발 자료의 후속 비교이며 독립 최종 평가가 아니다.",
  "temperature_aggregation": ["mean", "coldest", "warmest"],
